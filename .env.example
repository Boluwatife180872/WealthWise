# Convex (https://convex.dev)
# 1. Create an account at https://convex.dev
# 2. Create a new project
# 3. Run `npx convex dev` to link the project
# 4. The deployment URL will be shown after linking
VITE_CONVEX_URL="https://your-project.convex.cloud"

# OAuth (optional — for Google & GitHub sign-in)
# 1. Google: https://console.cloud.google.com/apis/credentials → Create OAuth client ID (Web application)
#    Add redirect URI: https://oauth2.googleapis.com/tokeninfo
# VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# 2. GitHub: https://github.com/settings/developers → New OAuth App
#    Add callback URL: https://your-domain.vercel.app/auth
# VITE_GITHUB_CLIENT_ID="your-github-client-id"
# Convex env vars (set via `npx convex env set`):
#   npx convex env set GOOGLE_CLIENT_ID your-google-client-id
#   npx convex env set GITHUB_CLIENT_ID your-github-client-id
#   npx convex env set GITHUB_CLIENT_SECRET your-github-client-secret
